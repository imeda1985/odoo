#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "QWeb"
msgstr "QWeb"

#. module: http_routing
#: model:ir.model,name:http_routing.model_ir_qweb
msgid "Qweb"
msgstr "QWeb"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "The error occurred while rendering the template"
msgstr "შეცდომა მოხდა შაბლონის რენდერისას"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_403_layout_1
msgid "The page you were looking for could not be authorized."
msgstr "თქვენ მიერ მოთხოვნილ გვერდზე წვდომა არ არის ავტორიზებული."

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_400_layout_1
msgid "The server couldn't understand the request."
msgstr "სერვერმა მოთხოვნა ვერ გაიგო."

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "Traceback"
msgstr "Traceback"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid "We couldn't find the page you're looking for!"
msgstr "მოთხოვნილი გვერდი ვერ მოიძებნა!"

