#. module: http_routing
#: model:ir.module.module,description:base.module_http_routing
msgid ""
"\n"
"Proposes advanced routing options not available in web or base to keep\n"
"base modules simple.\n"
msgstr ""
"\n"
"გვთავაზობთ მარშრუტიზაციის გაფართოებულ ვარიანტებს, რომლებიც web-სა და base-ში "
"არ არის,\n"
"რათა საბაზისო მოდულები მარტივი დარჩეს.\n"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_400_layout_1
msgid "400: Bad Request"
msgstr "400: არასწორი მოთხოვნა"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_403_layout_1
msgid "403: Forbidden"
msgstr "403: წვდომა აკრძალულია"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_415_layout_1
msgid "415: Unsupported Media Type"
msgstr "415: მხარდაუჭერელი მედიის ტიპი"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_422_layout_1
msgid "422: Unprocessable Entity"
msgstr "422: დაუმუშავებელი ობიექტი"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid ""
"<b>Don't panic.</b> If you think it's our mistake, please send us a message "
"on"
msgstr "<b>ნუ ღელავთ.</b> თუ ფიქრობთ, რომ ეს ჩვენი შეცდომაა, გთხოვთ, მოგვწეროთ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.error_message
msgid "<strong>Error message:</strong>"
msgstr "<strong>შეცდომის შეტყობინება:</strong>"

