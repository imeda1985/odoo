#. module: account_qr_code_sepa
#: model:ir.module.module,description:base.module_account_qr_code_sepa
msgid ""
"\n"
"This module adds support for SEPA Credit Transfer QR-code generation.\n"
msgstr ""
"\n"
"ეს მოდული ამატებს SEPA საკრედიტო გადარიცხვის QR კოდის გენერირების "
"მხარდაჭერას.\n"

#. module: account_qr_code_sepa
#: model:ir.module.module,shortdesc:base.module_account_qr_code_sepa
msgid "Account SEPA QR Code"
msgstr "ანგარიშის SEPA QR კოდი"

#. module: account_qr_code_sepa
#: model:ir.model,name:account_qr_code_sepa.model_res_partner_bank
msgid "Bank Account"
msgstr "საბანკო ანგარიში"

#. module: account_qr_code_sepa
#. odoo-python
#: code:addons/account_qr_code_sepa/models/res_bank.py:0
msgid "Can't generate a SEPA QR Code with the %s currency."
msgstr "SEPA QR კოდის გენერირება %s ვალუტით შეუძლებელია."

#. module: account_qr_code_sepa
#. odoo-python
#: code:addons/account_qr_code_sepa/models/res_bank.py:0
msgid "Can't generate a SEPA QR code if the account type isn't IBAN."
msgstr "SEPA QR კოდის გენერირება შეუძლებელია, თუ ანგარიშის ტიპი არ არის IBAN."

#. module: account_qr_code_sepa
#. odoo-python
#: code:addons/account_qr_code_sepa/models/res_bank.py:0
msgid "Can't generate a SEPA QR code with a non SEPA iban."
msgstr "SEPA QR კოდის გენერირება შეუძლებელია არა-SEPA IBAN-ით."

#. module: account_qr_code_sepa
#: model:ir.model.fields,field_description:account_qr_code_sepa.field_res_partner_bank__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: account_qr_code_sepa
#: model:ir.model.fields,field_description:account_qr_code_sepa.field_res_partner_bank__id
msgid "ID"
msgstr "ID"

#. module: account_qr_code_sepa
#. odoo-python
#: code:addons/account_qr_code_sepa/models/res_bank.py:0
msgid "SEPA Credit Transfer QR"
msgstr "SEPA საკრედიტო გადარიცხვის QR"

#. module: account_qr_code_sepa
#. odoo-python
#: code:addons/account_qr_code_sepa/models/res_bank.py:0
msgid ""
"The account receiving the payment must have an account holder name or "
"partner name set."
msgstr ""
"გადახდის მიმღებ ანგარიშს უნდა ჰქონდეს მითითებული ანგარიშის მფლობელის ან "
"პარტნიორის სახელი."
