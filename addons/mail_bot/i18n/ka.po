#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"ოჰ, ეს ძალიან საყვარელია, მაგრამ, იცით, ბოტები ასე არ მუშაობენ. თქვენ "
"ჩემთვის ზედმეტად ადამიანი ხართ! მოდით, პროფესიონალურ ფარგლებში დავრჩეთ ❤️"

#. module: mail_bot
#: model:ir.module.module,summary:base.module_mail_bot
msgid "Add OdooBot in discussions"
msgstr "OdooBot-ის დამატება დისკუსიებში"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "გამორთული"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "სადისკუსიო არხი"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Go ahead - Try sending me an emoji 😊"
msgstr "მოდით - სცადეთ, გამომიგზავნოთ ემოჯი 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app settings."
msgstr ""
"შესანიშნავია! %(bold_start)sშაბლონური პასუხების%(bold_end)s მორგება "
"შეგიძლიათ დისკუსიის აპლიკაციის პარამეტრებში."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello 👋"
msgstr "გამარჯობა 👋"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "ჰმმ..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "სამწუხაროდ, ვერ გავიგე. ბოდიში!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide, "
"ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"იმდენად ჭკვიანი არ ვარ, რომ თქვენს კითხვას ვუპასუხო.%(new_line)sჩემი "
"გზამკვლევის გასავლელად დაწერეთ: %(command_start)sტურის "
"დაწყება%(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "უმოქმედო"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"It looks like you're not sure what to do next. Please type %(command_start)s/"
"%(command_end)s to see the suggestions, then select "
"%(command_start)shelp%(command_end)s and press Enter."
msgstr ""
"როგორც ჩანს, არ იცით, რა გააკეთოთ შემდეგ. აკრიფეთ %(command_start)s/"
"%(command_end)s შემოთავაზებების სანახავად, შემდეგ აირჩიეთ "
"%(command_start)shelp%(command_end)s და დააჭირეთ Enter-ს."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "საფოსტო ბოტი"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "არაინიციალიზებული"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not quite. To continue the tour, please send an emoji by typing "
"%(command_start)s:)%(command_end)s and pressing Enter, or by clicking the "
"%(smile_icon)s icon to pick one."
msgstr ""
"არც ისე. ტურის გასაგრძელებლად გამოგზავნეთ ემოჯი: აკრიფეთ "
"%(command_start)s:)%(command_end)s და დააჭირეთ Enter-ს, ან დააწკაპუნეთ "
"%(smile_icon)s ხატულაზე და აირჩიეთ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you're doing? Please type %(command_start)s::%(command_end)s "
"to see canned responses. Select one and press Enter."
msgstr ""
"არ იცით, რას აკეთებთ? აკრიფეთ %(command_start)s::%(command_end)s შაბლონური "
"პასუხების სანახავად. აირჩიეთ ერთ-ერთი და დააჭირეთ Enter-ს."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's Discuss application helps employees collaborate efficiently. I'm here "
"to help you explore its features."
msgstr ""
"Odoo-ს დისკუსიის აპლიკაცია თანამშრომლებს ეფექტიანად თანამშრომლობაში "
"ეხმარება. მე აქ ვარ, რომ მისი შესაძლებლობების გაცნობაში დაგეხმაროთ."

#. module: mail_bot
#: model:ir.module.module,shortdesc:base.module_mail_bot
msgid "OdooBot"
msgstr "OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "OdooBot-ის სტატუსი"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "OdooBot-ის შეცდომა"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "გაცნობა: დანართი"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "გაცნობა: შაბლონური პასუხი"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "გაცნობა: ბრძანება"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "გაცნობა: ემოჯი"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "გაცნობა: მოხსენიება"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: "
"%(command_start)sstart the tour%(command_end)s."
msgstr ""
"ბოდიში, მეძინება. ან არა! იქნებ უბრალოდ ვცდილობ, დავმალო, რომ ადამიანის ენა "
"არ მესმის...%(new_line)sშემიძლია შესაძლებლობები გაჩვენოთ, თუ დაწერთ: "
"%(command_start)sტურის დაწყება%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I'm not listening right now. To get my attention, "
"%(bold_start)smention me%(bold_end)s by typing "
"%(command_start)s@OdooBot%(command_end)s and selecting me."
msgstr ""
"ბოდიში, ახლა არ გისმენთ. ჩემი ყურადღების მისაპყრობად "
"%(bold_start)sმომიხსენიეთ%(bold_end)s: აკრიფეთ "
"%(command_start)s@OdooBot%(command_end)s და ამირჩიეთ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "გმადლობთ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "გმადლობთ გამოხმაურებისთვის. ნახვამდის!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "ეს არ არის ლამაზი! ბოტი ვარ, მაგრამ გრძნობები მაქვს... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That's the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the "
"tour%(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"ეს მიმოხილვა დასრულდა. შეგიძლიათ %(bold_start)sდახუროთ ეს "
"საუბარი%(bold_end)s ან აკრიფოთ %(command_start)sტურის დაწყება%(command_end)s "
"მის თავიდან სანახავად. სასიამოვნო გაცნობას გისურვებთ Odoo-სთან!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, first click the "
"%(plus_icon)s icon, then select %(paperclip_icon)s Attach files."
msgstr ""
"%(bold_start)sდანართის გასაგზავნად%(bold_end)s ჯერ დააწკაპუნეთ %(plus_icon)s "
"ხატულაზე, შემდეგ აირჩიეთ %(paperclip_icon)s ფაილების მიმაგრება."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To get started, try sending me an emoji 😊"
msgstr "დასაწყისისთვის სცადეთ, გამომიგზავნოთ ემოჯი 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To use special commands, %(bold_start)sstart your message with a "
"%(bold_end)s %(command_start)s/%(command_end)s. For example, try typing "
"%(command_start)s/help%(command_end)s."
msgstr ""
"სპეციალური ბრძანებების გამოსაყენებლად %(bold_start)sშეტყობინება დაიწყეთ "
"სიმბოლოთი%(bold_end)s %(command_start)s/%(command_end)s. მაგალითად, სცადეთ "
"აკრიფოთ %(command_start)s/help%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand that.%(new_line)sIf you "
"need help exploring our apps, please check out %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour "
"videos%(slides_link_end)s."
msgstr ""
"სამწუხაროდ, მხოლოდ ბოტი ვარ 😞 ეს ვერ გავიგე.%(new_line)sთუ ჩვენი "
"აპლიკაციების გაცნობაში დახმარება გჭირდებათ, გაეცანით "
"%(document_link_start)sჩვენს დოკუმენტაციას%(document_link_end)s ან "
"%(slides_link_start)sჩვენს ვიდეოებს%(slides_link_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "მომხმარებელი"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to "
"use canned responses. I've created a temporary one just for you."
msgstr ""
"მშვენიერია! 😇%(new_line)sაკრიფეთ %(command_start)s::%(command_end)s "
"შაბლონური პასუხების გამოსაყენებლად. სპეციალურად თქვენთვის დროებითი პასუხი "
"შევქმენი."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow, you're a natural!%(new_line)s Use @username to mention someone and grab "
"their attention.%(new_line)s %(bold_start)sTry mentioning me by "
"typing%(bold_end)s %(command_start)s@OdooBot%(command_end)s in your message."
msgstr ""
"ვაუ, ეს ბუნებრივად გამოგდით!%(new_line)s გამოიყენეთ @username, რომ ვინმე "
"მოიხსენიოთ და მისი ყურადღება მიიპყროთ.%(new_line)s %(bold_start)sსცადეთ ჩემი "
"მოხსენიება: აკრიფეთ%(bold_end)s %(command_start)s@OdooBot%(command_end)s "
"თქვენს შეტყობინებაში."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I'm here! 🎉 %(new_line)sNow, try %(bold_start)ssending an "
"attachment%(bold_end)s 📎 - maybe a picture of your cute dog... 🐕"
msgstr ""
"დიახ, აქ ვარ! 🎉 %(new_line)sახლა სცადეთ %(bold_start)sდანართის "
"გაგზავნა%(bold_end)s 📎 - იქნებ თქვენი საყვარელი ძაღლის სურათი... 🐕"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "fuck"
msgstr "fuck"

