msgstr "რიცხვის ლოგარითმი e ფუძით (ეილერის რიცხვი)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, for a given base."
msgstr "რიცხვის ლოგარითმი მოცემული ფუძით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The low end of the random range."
msgstr "შემთხვევითი დიაპაზონის ქვედა ზღვარი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The lower inflection point value must be a number"
msgstr "ქვედა გადაღუნვის წერტილის მნიშვნელობა რიცხვი უნდა იყოს"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
