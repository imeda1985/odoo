msgstr "უჯრების საცნობარო დიაპაზონიდან დასაბრუნებელი სვეტის ინდექსი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the row to be returned from within the reference range of cells."
msgstr "უჯრების საცნობარო დიაპაზონიდან დასაბრუნებელი მწკრივის ინდექსი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The info_type should be one of %s."
msgstr "info_type უნდა იყოს ერთ-ერთი შემდეგიდან: %s."

