msgstr "პირველი მნიშვნელობა რიცხვი უნდა იყოს"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value."
msgstr "პირველი მნიშვნელობა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first_period (%(first)s) must be smaller or equal to the last_period "
"(%(last)s)."
msgstr ""
"first_period (%(first)s) უნდა იყოს last_period-ზე (%(last)s) ნაკლები ან ტოლი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first_period (%s) must be strictly positive."
msgstr "first_period (%s) მკაცრად დადებითი უნდა იყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The format entered is not valid."
msgstr "შეყვანილი ფორმატი არასწორია."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The format of the returned data."
msgstr "დაბრუნებული მონაცემების ფორმატი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit should be 'k', 'm' or 'b'."
msgstr "ფორმატირების ერთეული უნდა იყოს 'k', 'm' ან 'b'."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit. Use 'k', 'm', or 'b' to force the unit"
msgstr ""
"ფორმატირების ერთეული. ერთეულის იძულებით მისათითებლად გამოიყენეთ 'k', 'm' ან "
"'b'"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formula must be valid"
msgstr "ფორმულა სწორი უნდა იყოს"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The frequency (%s) must be one of %s"
msgstr "სიხშირე (%s) უნდა იყოს ერთ-ერთი შემდეგიდან: %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
