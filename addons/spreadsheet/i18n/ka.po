msgstr "გადარქმევა"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Reorder range"
msgstr "დიაპაზონის გადალაგება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Replace"
msgstr "ჩანაცვლება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Replace all"
msgstr "ყველას ჩანაცვლება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Replace text in a string based on the supplied regular expression."
msgstr ""
"სტრიქონში ტექსტის ჩანაცვლება მითითებული რეგულარული გამოსახულების მიხედვით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Replaces existing text with new text in a string."
msgstr "სტრიქონში არსებულ ტექსტს ახალი ტექსტით ცვლის."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Replaces part of a text string with different text."
msgstr "ტექსტური სტრიქონის ნაწილს სხვა ტექსტით ცვლის."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Reset"
msgstr "საწყისზე დაბრუნება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Reset size"
msgstr "ზომის საწყისზე დაბრუნება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Result couldn't be automatically expanded."
msgstr "შედეგის ავტომატურად გაშლა ვერ მოხერხდა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Result of multiplying a series of numbers together."
msgstr "რიცხვების მიმდევრობის გადამრავლების შედეგი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return a whole number or a decimal value."
msgstr "აბრუნებს მთელ ან ათწილად რიცხვს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return every distinct item"
msgstr "ყველა განსხვავებული ელემენტის დაბრუნება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return items that appear exactly once"
msgstr "მხოლოდ ერთხელ გვხვდება ელემენტების დაბრუნება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/pivot/pivot_functions.js:0
msgid "Return the current value of a spreadsheet filter."
msgstr "აბრუნებს ცხრილის ფილტრის მიმდინარე მნიშვნელობას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/pivot/pivot_functions.js:0
msgid "Return the label of the current value of a spreadsheet filter."
msgstr "აბრუნებს ცხრილის ფილტრის მიმდინარე მნიშვნელობის წარწერას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return unique columns"
msgstr "უნიკალური სვეტების დაბრუნება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return unique rows"
msgstr "უნიკალური მწკრივების დაბრუნება"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a cell reference as a string. "
msgstr "აბრუნებს უჯრის მითითებას სტრიქონის სახით. "

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns a filtered version of the source range, returning only rows or "
"columns that meet the specified conditions."
msgstr ""
"აბრუნებს წყარო დიაპაზონის გაფილტრულ ვერსიას, მხოლოდ მითითებული პირობების "
"დამაკმაყოფილებელი მწკრივებით ან სვეტებით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a formula as a string."
msgstr "აბრუნებს ფორმულას სტრიქონის სახით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a grid of random numbers between 0 inclusive and 1 exclusive."
msgstr ""
"აბრუნებს შემთხვევითი რიცხვების ბადეს 0-დან (ჩათვლით) 1-მდე (არაჩათვლით)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a n x n unit matrix, where n is the input dimension."
msgstr "აბრუნებს n x n ერთეულოვან მატრიცას, სადაც n შემავალი განზომილებაა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns a range reference shifted by a specified number of rows and columns "
"from a starting cell reference."
msgstr ""
"აბრუნებს დიაპაზონის მითითებას, საწყისი უჯრის მითითებიდან მწკრივებისა და "
"სვეტების მითითებული რაოდენობით წანაცვლებულს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a result array constrained to a specific width and height."
msgstr "აბრუნებს მითითებული სიგანისა და სიმაღლით შეზღუდულ შედეგის მასივს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a sequence of numbers."
msgstr "აბრუნებს რიცხვების მიმდევრობას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns a specified number of contiguous rows or columns from the start or "
"end of an array."
msgstr ""
"აბრუნებს მასივის დასაწყისიდან ან ბოლოდან მიმდებარე მწკრივების ან სვეტების "
"მითითებულ რაოდენობას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns a subtotal for a vertical range of cells using a specified "
"aggregation function."
msgstr ""
"აბრუნებს უჯრების ვერტიკალური დიაპაზონის ქვეჯამს მითითებული აგრეგაციის "
"ფუნქციით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a value by comparing cases to an expression."
msgstr "აბრუნებს მნიშვნელობას გამოსახულებასთან შემთხვევების შედარებით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns a value depending on multiple logical expressions."
msgstr "აბრუნებს მნიშვნელობას რამდენიმე ლოგიკური გამოსახულების მიხედვით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns an absolute reference as plain text of the top left cell in "
"reference."
msgstr ""
"აბრუნებს მითითების ზედა მარცხენა უჯრის აბსოლუტურ მითითებას უბრალო ტექსტის "
"სახით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns an element from a list of choices based on index."
msgstr "აბრუნებს ელემენტს არჩევანის სიიდან ინდექსის მიხედვით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns opposite of provided logical value."
msgstr "აბრუნებს მოცემული ლოგიკური მნიშვნელობის საპირისპიროს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns text that occurs after a given substring or delimiter."
msgstr "აბრუნებს ტექსტს, რომელიც მოცემული ქვესტრიქონის ან გამყოფის შემდეგაა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns text that occurs before a given substring or delimiter."
msgstr "აბრუნებს ტექსტს, რომელიც მოცემული ქვესტრიქონის ან გამყოფის წინაა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the column number of the cell in reference."
msgstr "აბრუნებს მითითებული უჯრის სვეტის ნომერს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the content of a cell, specified by a string."
msgstr "აბრუნებს სტრიქონით მითითებული უჯრის შიგთავსს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the content of a cell, specified by row and column offset."
msgstr "აბრუნებს მწკრივისა და სვეტის წანაცვლებით მითითებული უჯრის შიგთავსს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the error value #N/A."
msgstr "აბრუნებს შეცდომის მნიშვნელობას #N/A."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the first n items in a data set after performing a sort."
msgstr "აბრუნებს მონაცემთა ნაკრების პირველ n ელემენტს დალაგების შემდეგ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the format of the top left cell in reference."
msgstr "აბრუნებს მითითების ზედა მარცხენა უჯრის ფორმატს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the interest paid at a particular period of an investment."
msgstr "აბრუნებს ინვესტიციის კონკრეტულ პერიოდში გადახდილ პროცენტს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the matrix determinant of a square matrix."
msgstr "აბრუნებს კვადრატული მატრიცის დეტერმინანტს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the maximum value in a range of cells, filtered by a set of criteria."
msgstr ""
"აბრუნებს უჯრების დიაპაზონის მაქსიმალურ მნიშვნელობას, გაფილტრულს "
"კრიტერიუმების ნაკრებით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the minimum value in a range of cells, filtered by a set of criteria."
msgstr ""
"აბრუნებს უჯრების დიაპაზონის მინიმალურ მნიშვნელობას, გაფილტრულს კრიტერიუმების "
"ნაკრებით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the multiplicative inverse of a square matrix."
msgstr "აბრუნებს კვადრატული მატრიცის შებრუნებულ მატრიცას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the p-value of a Student's t-test."
msgstr "აბრუნებს სტიუდენტის t-ტესტის p-მნიშვნელობას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the p-value of a chi-square test for independence, comparing actual "
"to expected values."
msgstr ""
"აბრუნებს ხი-კვადრატ დამოუკიდებლობის ტესტის p-მნიშვნელობას, ფაქტობრივი და "
"მოსალოდნელი მნიშვნელობების შედარებით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the rank of a specified value in a dataset."
msgstr "აბრუნებს მითითებული მნიშვნელობის რანგს მონაცემთა ნაკრებში."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the row number of the top left cell in reference."
msgstr "აბრუნებს მითითების ზედა მარცხენა უჯრის მწკრივის ნომერს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the two-tailed p-value of an F-test comparing the variances of two "
"datasets."
msgstr ""
"აბრუნებს ორი მონაცემთა ნაკრების დისპერსიების შედარების F-ტესტის ორმხრივ p-"
"მნიშვნელობას."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the type of data in the cell in reference. The following values are "
"returned: \"b\" for a blank cell, \"l\" (for label) if the cell contains "
"plain text, and \"v\" (for value) if the cell contains any other type of "
"data."
msgstr ""
"აბრუნებს მითითების უჯრაში არსებული მონაცემების ტიპს. ბრუნდება შემდეგი "
"მნიშვნელობები: \"b\" ცარიელი უჯრისთვის, \"l\" (label – წარწერა), თუ უჯრა "
"უბრალო ტექსტს შეიცავს, და \"v\" (value – მნიშვნელობა), თუ უჯრა ნებისმიერი "
"სხვა ტიპის მონაცემს შეიცავს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the value contained in the top left cell in reference."
msgstr "აბრუნებს მითითების ზედა მარცხენა უჯრაში არსებულ მნიშვნელობას."

#. module: spreadsheet
#. odoo-javascript
