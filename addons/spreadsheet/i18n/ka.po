"გამორიცხავს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to offset by."
msgstr "წანაცვლების მწკრივების რაოდენობა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to return"
msgstr "დასაბრუნებელი მწკრივების რაოდენობა"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows to take. A negative value takes from the end of the array."
msgstr ""
"ასაღები მწკრივების რაოდენობა. უარყოფითი მნიშვნელობა მასივის ბოლოდან იღებს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of significant digits to the right of the decimal point to retain."
msgstr ""
"ათწილადის წერტილის მარჯვნივ შესანარჩუნებელი მნიშვნელოვანი ციფრების რაოდენობა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of the character to look up from the current Unicode table in "
"decimal format."
msgstr "მიმდინარე Unicode ცხრილში მოსაძებნი სიმბოლოს ნომერი ათობით ფორმატში."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to begin the cumulative calculation."
msgstr "გადახდის პერიოდის ნომერი, საიდანაც იწყება კუმულაციური გამოთვლა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to end the cumulative calculation."
msgstr "გადახდის პერიოდის ნომერი, რომლითაც სრულდება კუმულაციური გამოთვლა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of values in a dataset."
msgstr "მონაცემთა ნაკრებში მნიშვნელობების რაოდენობა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of which to return the absolute value."
msgstr "რიცხვი, რომლის აბსოლუტური მნიშვნელობაც უნდა დაბრუნდეს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole months between start_date and end_date"
msgstr "სრული თვეების რაოდენობა start_date-სა და end_date-ს შორის"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of whole months between start_date and end_date after subtracting "
"whole years"
msgstr ""
"სრული თვეების რაოდენობა start_date-სა და end_date-ს შორის სრული წლების "
"გამოკლების შემდეგ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole years between start_date and end_date"
msgstr "სრული წლების რაოდენობა start_date-სა და end_date-ს შორის"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of working days to advance from start_date. If negative, counts "
"backwards."
msgstr ""
"სამუშაო დღეების რაოდენობა, რომლითაც უნდა გადაიწიოს start_date-დან. "
"უარყოფითის შემთხვევაში ითვლის უკან."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number pi."
msgstr "რიცხვი პი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided to find the remainder."
msgstr "რიცხვი, რომელიც იყოფა ნაშთის საპოვნელად."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided."
msgstr "გასაყოფი რიცხვი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to convert."
msgstr "გადასაყვანი რიცხვი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to divide by."
msgstr "რიცხვი, რომელზეც უნდა გაიყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to have its sign reversed. Equivalently, the number to multiply "
"by -1."
msgstr ""
"რიცხვი, რომლის ნიშანიც უნდა შებრუნდეს. სხვა სიტყვებით, რიცხვი, რომელიც -1-ზე "
"უნდა გამრავლდეს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to raise to the exponent power."
msgstr "რიცხვი, რომელიც ხარისხში უნდა აიყვანოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to return."
msgstr "დასაბრუნებელი რიცხვი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to round down to the nearest integer."
msgstr "რიცხვი, რომელიც ქვემოთ უნდა დამრგვალდეს უახლოეს მთელ რიცხვამდე."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples number will be rounded."
msgstr "რიცხვი, რომლის ჯერადამდეც დამრგვალდება number."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to whose multiples number will be rounded. The sign of "
"significance will be ignored."
msgstr ""
"რიცხვი, რომლის ჯერადამდეც დამრგვალდება number. significance-ის ნიშანი "
"იგნორირებულია."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples value will be rounded."
msgstr "რიცხვი, რომლის ჯერადამდეც დამრგვალდება value."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number, date or time to format."
msgstr "დასაფორმატებელი რიცხვი, თარიღი ან დრო."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number."
msgstr "რიცხვი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_characters (%s) must be positive or null."
msgstr "number_of_characters (%s) უნდა იყოს დადებითი ან ნული."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_characters (%s) must be positive or zero."
msgstr "number_of_characters (%s) უნდა იყოს დადებითი ან ნული."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be different from zero."
msgstr "number_of_periods (%s) უნდა განსხვავდებოდეს ნულისგან."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be strictly positive."
msgstr "number_of_periods (%s) მკაცრად დადებითი უნდა იყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The occurrenceNumber (%s) must be positive or null."
msgstr "occurrenceNumber (%s) უნდა იყოს დადებითი ან ნული."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The one-dimensional array to be searched."
msgstr "საძიებო ერთგანზომილებიანი მასივი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The order of the polynomial to fit the data, between 1 and 6."
msgstr "მონაცემების მოსარგები პოლინომის რიგი, 1-დან 6-მდე."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range."
msgstr "criteria_range-ზე გამოსაყენებელი შაბლონი ან შემოწმება."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to range."
msgstr "range-ზე გამოსაყენებელი შაბლონი ან შემოწმება."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The percentile whose value within data will be calculated and returned."
msgstr "პროცენტილი, რომლის მნიშვნელობაც data-ში გამოითვლება და დაბრუნდება."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The percentile, exclusive of 0 and 1, whose value within 'data' will be "
"calculated and returned."
msgstr ""
"პროცენტილი, 0-ისა და 1-ის გამოკლებით, რომლის მნიშვნელობაც 'data'-ში "
"გამოითვლება და დაბრუნდება."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal life (%(life)s)."
msgstr "პერიოდი (%(period)s) უნდა იყოს life-ზე (%(life)s) ნაკლები ან ტოლი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal to %(lifeLimit)s."
msgstr "პერიოდი (%(period)s) უნდა იყოს %(lifeLimit)s-ზე ნაკლები ან ტოლი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be positive or null."
msgstr "პერიოდი (%s) უნდა იყოს დადებითი ან ნული."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be strictly positive."
msgstr "პერიოდი (%s) მკაცრად დადებითი უნდა იყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period for which you want to view the interest payment."
msgstr "პერიოდი, რომლისთვისაც გსურთ პროცენტის გადახდის ნახვა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period must be between 1 and number_of_periods (%s)"
msgstr "პერიოდი უნდა იყოს 1-სა და number_of_periods-ს (%s) შორის"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The periods_by_year (%s) must be strictly positive."
msgstr "periods_by_year (%s) მკაცრად დადებითი უნდა იყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains a reserved value"
msgstr ""
"პივოტის შექმნა შეუძლებელია, რადგან უჯრა %s შეიცავს დარეზერვებულ მნიშვნელობას"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains an error"
msgstr "პივოტის შექმნა შეუძლებელია, რადგან უჯრა %s შეიცავს შეცდომას"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s is empty"
msgstr "პივოტის შექმნა შეუძლებელია, რადგან უჯრა %s ცარიელია"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because the dataset is missing."
msgstr "პივოტის შექმნა შეუძლებელია, რადგან მონაცემთა ნაკრები არ არის."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The population standard deviation."
msgstr "პოპულაციის სტანდარტული გადახრა."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position (%s) must be greater than or equal to 1."
msgstr "პოზიცია (%s) უნდა იყოს 1-ზე მეტი ან ტოლი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position where the replacement will begin (starting from 1)."
msgstr "პოზიცია, საიდანაც დაიწყება ჩანაცვლება (1-დან დაწყებული)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present value of the investment."
msgstr "ინვესტიციის მიმდინარე ღირებულება."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present_value (%s) must be strictly positive."
msgstr "present_value (%s) მკაცრად დადებითი უნდა იყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price (%s) must be strictly positive."
msgstr "ფასი (%s) მკაცრად დადებითი უნდა იყოს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought per 100 face value."
msgstr "ფასიანი ქაღალდის შესყიდვის ფასი 100 ერთეულ ნომინალურ ღირებულებაზე."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought."
msgstr "ფასიანი ქაღალდის შესყიდვის ფასი."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given as a decimal value."
msgstr "ფასის კოტირება ათწილადი მნიშვნელობით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given using fractional decimal conventions."
msgstr "ფასის კოტირება წილადური ათობითი ჩანაწერით."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The purchase_date (%(purchaseDate)s) must be before the first_period_end "
"(%(firstPeriodEnd)s)."
msgstr ""
"purchase_date (%(purchaseDate)s) უნდა იყოს first_period_end-მდე "
"(%(firstPeriodEnd)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The purchase_date (%s) must be positive or null."
msgstr "purchase_date (%s) უნდა იყოს დადებითი ან ნული."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the dataset to consider."
msgstr "დიაპაზონი, რომელიც შეიცავს განსახილველ მონაცემთა ნაკრებს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the expected values."
msgstr "დიაპაზონი, რომელიც შეიცავს მოსალოდნელ მნიშვნელობებს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the observed values."
msgstr "დიაპაზონი, რომელიც შეიცავს დაკვირვებულ მნიშვნელობებს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range containing the return value. Should have the same dimensions as "
"lookup_range."
msgstr ""
"დიაპაზონი, რომელიც შეიცავს დასაბრუნებელ მნიშვნელობას. უნდა ჰქონდეს "
"lookup_range-ის იგივე ზომები."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the set of classes."
msgstr "დიაპაზონი, რომელიც შეიცავს კლასების სიმრავლეს."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range from which to return a result. The value returned corresponds to "
"the location where search_key is found in search_range. This range must be "
"only a single row or column and should not be used if using the "
"search_result_array method."
msgstr ""
"დიაპაზონი, საიდანაც ბრუნდება შედეგი. დაბრუნებული მნიშვნელობა შეესაბამება იმ "
"მდებარეობას, სადაც search_key მოიძებნა search_range-ში. ეს დიაპაზონი უნდა "
"იყოს მხოლოდ ერთი მწკრივი ან სვეტი და არ უნდა იქნეს გამოყენებული "
"search_result_array მეთოდის გამოყენებისას."

